#
# Reference unified diff illustrating the 8 integration hook points applied to
# mainline Linux drivers/net/wireless/realtek/rtw89/ (Linux 6.11 - 7.x+ layout).
#
# Tip: Use `python3 scripts/patch_rtw89.py --rtw89-dir <path> --apply` to apply
# these hooks automatically across both Linux 6.1-6.10 (API Gen 1) and
# Linux 6.11-7.x+ (API Gen 2) source trees.

--- a/drivers/net/wireless/realtek/rtw89/Makefile
+++ b/drivers/net/wireless/realtek/rtw89/Makefile
@@ -24,3 +24,6 @@ rtw89_core-y += core.o \
 		wow.o \
 		acpi.o
+
+# RTW89_MON_EXT
+rtw89_core-y += rtw89_mon.o

--- a/drivers/net/wireless/realtek/rtw89/core.c
+++ b/drivers/net/wireless/realtek/rtw89/core.c
@@ -20,6 +20,7 @@
 #include "txrx.h"
 #include "util.h"
 #include "wow.h"
+#include "rtw89_mon.h"
 
@@ -630,6 +631,8 @@ int rtw89_set_channel(struct rtw89_dev *rtwdev)
 
 	__rtw89_set_channel(rtwdev, &chan_bak, RTW89_MAC_0, RTW89_PHY_0);
+	/* RTW89_MON_EXT */
+	rtw89_mon_post_set_channel(rtwdev);
 	if (rtwdev->chip->chip_gen == RTW89_CHIP_AX)
 		return 0;
 
@@ -1220,6 +1223,8 @@ static void rtw89_core_tx_update_desc_info(struct rtw89_dev *rtwdev,
 	case RTW89_CORE_TX_TYPE_FWCMD:
 		rtw89_core_tx_update_h2c_info(rtwdev, tx_req);
 		break;
 	}
+
+	/* RTW89_MON_EXT */
+	rtw89_mon_fixup_tx_desc(rtwdev, tx_req);
 }
 
@@ -1395,9 +1400,14 @@ int rtw89_core_tx_write(struct rtw89_dev *rtwdev, struct ieee80211_vif *vif,
 			int *txdesc_size)
 {
 	struct rtw89_core_tx_request tx_req = {};
-	struct rtw89_vif *rtwvif = vif_to_rtwvif(vif);
+	struct rtw89_vif *rtwvif;
 	int ret;
 
+	/* RTW89_MON_EXT: resolve NULL vif on monitor TX */
+	vif = rtw89_mon_resolve_tx_vif(rtwdev, vif);
+	if (!vif)
+		return -ENODEV;
+	rtwvif = vif_to_rtwvif(vif);
+
 	tx_req.skb = skb;
 	tx_req.tx_type = tx_type;
 
@@ -5410,6 +5420,8 @@ static int rtw89_core_register_hw(struct rtw89_dev *rtwdev)
 	if (ret)
 		return ret;
 
+	/* RTW89_MON_EXT */
+	rtw89_mon_register_hw_caps(rtwdev);
 	ret = ieee80211_register_hw(hw);
 	if (ret) {

--- a/drivers/net/wireless/realtek/rtw89/mac80211.c
+++ b/drivers/net/wireless/realtek/rtw89/mac80211.c
@@ -16,6 +16,7 @@
 #include "reg.h"
 #include "sar.h"
 #include "util.h"
+#include "rtw89_mon.h"
 
@@ -26,9 +27,17 @@ static void rtw89_ops_tx(struct ieee80211_hw *hw,
 	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
 	struct ieee80211_vif *vif = info->control.vif;
-	struct rtw89_vif *rtwvif = vif_to_rtwvif(vif);
+	struct rtw89_vif *rtwvif;
 	struct ieee80211_sta *sta = control->sta;
 	u32 flags = IEEE80211_SKB_CB(skb)->flags;
 	int ret, qsel;
 
+	/* RTW89_MON_EXT: guard against NULL control.vif on monitor TX */
+	vif = rtw89_mon_resolve_tx_vif(rtwdev, vif);
+	if (!vif) {
+		ieee80211_free_txskb(hw, skb);
+		return;
+	}
+	rtwvif = vif_to_rtwvif(vif);
+
 	if (rtwvif->offchan && !(flags & IEEE80211_TX_CTL_TX_OFFCHAN) &&
 
@@ -175,6 +184,8 @@ static int rtw89_ops_add_interface(struct ieee80211_hw *hw,
 	rtw89_recalc_lps(rtwdev);
+	/* RTW89_MON_EXT */
+	rtw89_mon_add_vif_post(rtwdev, vif);
 	return 0;
 
@@ -205,6 +216,8 @@ static void rtw89_ops_remove_interface(struct ieee80211_hw *hw,
 	lockdep_assert_wiphy(hw->wiphy);
+	/* RTW89_MON_EXT */
+	rtw89_mon_remove_vif_pre(rtwdev, vif);
 
@@ -595,6 +608,8 @@ static void rtw89_ops_configure_filter(struct ieee80211_hw *hw,
 	rtw89_mac_set_rx_fltr(rtwdev, RTW89_MAC_0, rx_fltr);
+	/* RTW89_MON_EXT */
+	rtw89_mon_apply_rx_filter(rtwdev, new_flags);
 	if (!rtwdev->dbcc_en)
 		return;
