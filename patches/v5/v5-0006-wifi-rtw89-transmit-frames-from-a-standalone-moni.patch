From a6de002f3da46e52ead9cb003d824ab6ddc81c9d Mon Sep 17 00:00:00 2001
From: Enver Ikromov <owner@ph4ntom-rev.uz>
Date: Tue, 10 Nov 2026 18:06:00 +0500
Subject: [PATCH v5 06/10] wifi: rtw89: transmit frames from a standalone
 monitor interface

Frames injected on a monitor interface reach rtw89_ops_tx() either
with info->control.vif == NULL, with a monitor vif, or with a running
interface matched by addr2.

Passing local->monitor_sdata directly is racy because
ieee80211_del_virtual_monitor() calls drv_remove_interface() before
clearing local->monitor_sdata, so mac80211 may still pass the virtual
monitor vif to rtw89_ops_tx() after the driver has released its MAC ID
and port.

Resolve NULL and monitor vifs through rtwdev->pure_monitor_mode_vif
under rcu_read_lock(), and verify with skb_headlen() that injected
frames carry a complete linear 802.11 header before accessing header
fields in skb->data. Frames from monitor interfaces are dropped when
no standalone monitor vif exists, preserving the drop behavior while a
non-monitor interface is active.

Signed-off-by: Enver Ikromov <owner@ph4ntom-rev.uz>
---
 drivers/net/wireless/realtek/rtw89/mac80211.c | 43 ++++++++++++++++---
 1 file changed, 36 insertions(+), 7 deletions(-)

diff --git a/drivers/net/wireless/realtek/rtw89/mac80211.c b/drivers/net/wireless/realtek/rtw89/mac80211.c
index ab06172..771e8c9 100644
--- a/drivers/net/wireless/realtek/rtw89/mac80211.c
+++ b/drivers/net/wireless/realtek/rtw89/mac80211.c
@@ -28,28 +28,57 @@ static void rtw89_ops_tx(struct ieee80211_hw *hw,
 	struct rtw89_vif *rtwvif;
 	int ret, qsel;
 
-	if (unlikely(!vif)) {
-		ieee80211_free_txskb(hw, skb);
-		return;
-	}
+	rcu_read_lock();
+
+	if (unlikely(!vif || vif->type == NL80211_IFTYPE_MONITOR)) {
+		struct ieee80211_hdr *hdr = (void *)skb->data;
 
-	rtwvif = vif_to_rtwvif(vif);
+		/* Frames from monitor interfaces are only sent when a monitor
+		 * vif is the sole active interface. The pointer is cleared and
+		 * synchronize_rcu() is called before that vif is removed, so
+		 * a vif that mac80211 is still tearing down is never used.
+		 */
+		rtwvif = rcu_dereference(rtwdev->pure_monitor_mode_vif);
+		if (!rtwvif || skb_headlen(skb) < sizeof(struct ieee80211_cts) ||
+		    skb_headlen(skb) < ieee80211_hdrlen(hdr->frame_control)) {
+			ieee80211_free_txskb(hw, skb);
+			goto out;
+		}
+
+		vif = rtwvif_to_vif(rtwvif);
+		info->control.vif = vif;
+	} else {
+		if (unlikely(flags & IEEE80211_TX_CTL_INJECTED)) {
+			struct ieee80211_hdr *hdr = (void *)skb->data;
+
+			if (skb_headlen(skb) < sizeof(struct ieee80211_cts) ||
+			    skb_headlen(skb) < ieee80211_hdrlen(hdr->frame_control)) {
+				ieee80211_free_txskb(hw, skb);
+				goto out;
+			}
+		}
+
+		rtwvif = vif_to_rtwvif(vif);
+	}
 
 	if (rtwvif->offchan && !(flags & IEEE80211_TX_CTL_TX_OFFCHAN) && sta) {
 		struct rtw89_sta *rtwsta = sta_to_rtwsta(sta);
 
 		rtw89_debug(rtwdev, RTW89_DBG_TXRX, "ops_tx during offchan\n");
 		skb_queue_tail(&rtwsta->roc_queue, skb);
-		return;
+		goto out;
 	}
 
 	ret = rtw89_core_tx_write(rtwdev, vif, sta, skb, &qsel);
 	if (ret) {
 		rtw89_err(rtwdev, "failed to transmit skb: %d\n", ret);
 		ieee80211_free_txskb(hw, skb);
-		return;
+		goto out;
 	}
 	rtw89_core_tx_kick_off(rtwdev, qsel);
+
+out:
+	rcu_read_unlock();
 }
 
 static void rtw89_ops_wake_tx_queue(struct ieee80211_hw *hw,
